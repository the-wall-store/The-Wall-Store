rules_version = '2';

// Keep this OWNER_EMAILS list in sync with config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null &&
        request.auth.token.email in [
          "shivi260121@gmail.com"
        ];
    }

    // Anyone (even signed-out visitors) can browse products.
    // Only the owner can add, edit, or delete them.
    // Note: a product doc includes a "keywords" field meant for admin-only
    // search use. Firestore can't hide individual fields on a publicly
    // readable document — true field-level privacy would need a paid
    // Cloud Functions backend. This field just isn't rendered anywhere in
    // the storefront UI.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Admin-defined categories shown on the store page. Public read so the
    // store can group products by section; only the owner can manage them.
    match /sections/{sectionId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Global size options (label + optional scale-reference image), shared
    // across all posters. Public read so the store can show them; only the
    // owner can manage them.
    match /sizes/{sizeId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // A signed-in customer can create an order for themselves and read
    // their own orders. Only the owner can read all orders, or change
    // an order's status (mark paid / fulfilled / rejected).
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && (isOwner() || resource.data.userId == request.auth.uid);
      allow update: if isOwner()
                    || (request.auth != null
                        && resource.data.userId == request.auth.uid
                        // customers may only flip this one field themselves
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["customerConfirmedPaid"]));
      allow delete: if isOwner();
    }

    // Each signed-in customer can read/write only their own saved shipping
    // profile (name/phone/address/pincode — used to prefill checkout next
    // time they order).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Payment settings (UPI id / payee name / custom QR image). Everyone
    // needs to read this so the checkout screen can show the QR code —
    // only the owner can change it from Admin → Payment.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
