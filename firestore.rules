rules_version = '2';

// Keep this OWNER_EMAILS list in sync with config.js and storage.rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null &&
        request.auth.token.email in [
          "shivi260121@gmail.com"
        ];
    }
    function isSignedIn() {
      return request.auth != null;
    }

    // Anyone can browse products (posters + collections). Only the owner
    // can add, edit, or delete them.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Section tabs (e.g. "Music", "Movies"). Everyone reads them to build
    // the store tabs; only the owner manages them.
    match /sections/{sectionId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Sizes + their scale-reference images. Same pattern.
    match /sizes/{sizeId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Orders are now only ever created once — after the customer taps
    // "I've paid" — and the whole document (items, total, shipping,
    // customerConfirmedPaid: true, seenByAdmin: false) is written in that
    // single create call. Customers never patch a doc afterwards, so only
    // the owner needs update access (status changes, seenByAdmin flips).
    match /orders/{orderId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.customerConfirmedPaid == true;
      allow read: if isOwner()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // Each signed-in customer can read/write only their own saved shipping
    // profile (used to prefill/confirm checkout next time).
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Payment settings (UPI id / payee name / QR image) and the Help page
    // (content + contacts): everyone can read so the store works for
    // signed-out visitors too; only the owner can edit either.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
