rules_version = '2';

// Keep this OWNER_EMAILS list in sync with config.js and storage.rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null &&
        request.auth.token.email in [
          "shivi260121@gmail.com"
        ];
    }

    // Anyone (even signed-out visitors) can browse products.
    // Only the owner can add, edit, or delete them.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // A signed-in customer can create an order for themselves and read
    // their own orders. Only the owner can read all orders, or change
    // an order's status (mark paid / fulfilled / rejected).
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && (isOwner() || resource.data.userId == request.auth.uid);
      allow update: if isOwner()
                    || (request.auth != null
                        && resource.data.userId == request.auth.uid
                        // customers may only flip this one field themselves
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["customerConfirmedPaid"]));
      allow delete: if isOwner();
    }
  }
}
